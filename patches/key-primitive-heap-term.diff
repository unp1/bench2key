+    /** Whether the term builds a heap from another one, so that something in it may collapse. */
+    /**
+     * Whether the term builds a heap out of another heap.
+     *
+     * Asked structurally rather than against a list of the operators the heap theory happens to
+     * have: what the callers want to know is whether anything inside the term can still collapse,
+     * and that is exactly the case when the term is a heap assembled from a heap. Anything else, a
+     * constant, a variable, or an application producing a heap without consuming one, is as inert
+     * as the base heap however it is written.
+     */
+    private boolean isHeapTransformer(Term t) {
+        if (t.sort() != heapLDT.targetSort()) {
+            return false;
+        }
+        for (int i = 0; i < t.arity(); i++) {
+            if (t.sub(i).sort() == heapLDT.targetSort()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
