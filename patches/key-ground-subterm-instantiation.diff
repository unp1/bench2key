+
+    /**
+     * Ceiling on ground subterm candidates taken from one quantified formula.
+     *
+     * Each candidate costs a cost prediction, so a formula built over many distinct ground terms
+     * would pay for a long tail of them. The instances that make a quantifier collapse are the few
+     * the formula names itself, so a small bound keeps what matters.
+     */
+    private static final int MAX_GROUND_SUBTERM_INSTANCES = 32;
+
+    /**
+     * Instance candidates taken from the quantified formula's own body.
+     *
+     * A subterm under the quantifier that contains no quantified variable is a well-sorted ground
+     * term, so instantiating with it is sound, but no trigger can produce it: matching binds a
+     * variable by finding it inside a pattern, and a term with no variable in it offers nothing to
+     * bind. Where a quantifier speaks about indices or values that its own body names literally,
+     * those are exactly the instances that let it collapse. A guard {@code 0 <= i & i <= 5} and a
+     * write {@code store(a, 0, 5)} carry the interesting indices with them.
+     *
+     * Candidates go through the same cost computation as matched ones, so those that lead nowhere
+     * are dropped there rather than here.
+     */
+    private void addGroundSubtermInstances(JTerm term, Services services, Set<Term> seen) {
+        if (seen.size() >= MAX_GROUND_SUBTERM_INSTANCES) {
+            return;
+        }
+        final Sort varSort = firstVar.sort();
+        if (term.sort() != JavaDLTheory.FORMULA && term.freeVars().isEmpty()
+                && term.sort().extendsTrans(varSort) && seen.add(term)) {
+            final ImmutableMap<QuantifiableVariable, Term> varMap =
+                DefaultImmutableMap.<QuantifiableVariable, Term>nilMap().put(firstVar, term);
+            addInstance(new Substitution(varMap), services);
+        }
+        for (int i = 0; i < term.arity(); i++) {
+            addGroundSubtermInstances(term.sub(i), services, seen);
         }
     }
 
